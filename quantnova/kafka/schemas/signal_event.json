{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "signal_event",
  "title": "SignalEvent",
  "description": "Alpha signal generated by a quantnova strategy or ML model",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "strategy_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "enum": ["signal.generated", "signal.expired", "signal.executed", "signal.rejected"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "strategy_id": { "type": "string", "format": "uuid" },
    "model_version_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["symbol_id", "signal_type", "strength"],
      "properties": {
        "symbol_id": { "type": "string", "format": "uuid" },
        "signal_type": { "type": "string", "enum": ["buy", "sell", "hold", "exit", "scale_in", "scale_out"] },
        "strength": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "target_price": { "type": "number" },
        "stop_loss": { "type": "number" },
        "time_horizon": { "type": "string", "enum": ["intraday", "swing", "positional", "long_term"] },
        "features": { "type": "object" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "correlation_id": { "type": "string", "format": "uuid" },
        "schema_version": { "type": "string", "default": "1.0.0" }
      }
    }
  }
}
