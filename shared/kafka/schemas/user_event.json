{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user_event",
  "title": "UserEvent",
  "description": "Domain event for user lifecycle changes in the shared domain",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "user_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "user.registered",
        "user.email_verified",
        "user.profile_updated",
        "user.password_changed",
        "user.deactivated",
        "user.deleted",
        "session.created",
        "session.expired",
        "api_key.created",
        "api_key.revoked",
        "subscription.created",
        "subscription.upgraded",
        "subscription.downgraded",
        "subscription.cancelled"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "ip_address": { "type": "string" },
        "user_agent": { "type": "string" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "schema_version": { "type": "string", "default": "1.0.0" }
      }
    }
  }
}
