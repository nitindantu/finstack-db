{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tax_event",
  "title": "TaxEvent",
  "description": "Domain event for tax year state changes in the NDFL domain",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "tax_year.created",
        "tax_year.filing_status_changed",
        "tax_year.filed",
        "tax_year.revised",
        "tax_computation.updated",
        "capital_gain.added",
        "tds_record.imported",
        "form26as.synced"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "tax_year_id": {
      "type": "string",
      "format": "uuid"
    },
    "assessment_year": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "description": "e.g. 2024-25"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data, schema varies by event_type"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "schema_version": { "type": "string", "default": "1.0.0" }
      }
    }
  }
}
